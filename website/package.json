{
  "name": "adenchase-website",
  "version": "0.1.0",
  "private": true,
  "description": "ADEN-CHASE Strategies corporate website — The Living Opportunity Engine",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "next build && node qa/run.mjs",
    "qa:only": "node qa/run.mjs",
    "qa:visual": "node qa/run.mjs --only=pages,motion",
    "qa:a11y": "node qa/run.mjs --only=a11y",
    "qa:perf": "node qa/run.mjs --only=perf",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "lighthouse": "13.6.0",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
