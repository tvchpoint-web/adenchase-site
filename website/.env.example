# ADEN-CHASE Strategies corporate website — environment variables.
# These are separate from the Client Portal and from AdenChase Labs. Do not reuse their keys.

# Public URL of the site (used for metadata / canonical links).
NEXT_PUBLIC_SITE_URL=https://adenchase.com

# Discreet "Client Portal" link. Defaults to the portal's current Vercel URL.
# Switch to https://portal.adenchase.com/login once that custom domain is configured.
NEXT_PUBLIC_PORTAL_URL=https://aden-chase-portal.vercel.app/login

# Private Engagement inquiries. Until BOTH are set, the form validates input but
# clearly tells visitors that online submission is not yet connected.
# RESEND_API_KEY=
# INQUIRY_TO=introductions@adenchase.com
# INQUIRY_FROM=ADEN-CHASE Strategies <no-reply@adenchase.com>
